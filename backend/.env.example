# Rename this file to .env and fill in real values

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/hammad_rent_car

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Payments (optional - Stripe)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# Image uploads (optional - Cloudinary, for admin car photo uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Booking notifications (optional - Gmail)
# ADMIN_EMAIL: where new-booking alerts are sent
# EMAIL_USER / EMAIL_PASS: the Gmail account that SENDS the alert (use a 16-char "App Password", not your normal password)
ADMIN_EMAIL=owner@example.com
EMAIL_USER=youraccount@gmail.com
EMAIL_PASS=your_16_char_app_password

# WhatsApp contact (shown on the website, digits only, with country code, no + or spaces)
ADMIN_WHATSAPP=923001234567
